# RustDesk 客户端统一使用的服务器地址。
RUSTDESK_ID_SERVER=desk-id.example.com

# hbbs 负责健康检查的全部 hbbr；必须包含规则里出现的所有节点。
RUSTDESK_RELAY_SERVERS=relay-cn.example.com,relay-jp.example.com,relay-us.example.com

# 是否启用基于双方 GeoLite2 信息的 Relay 选择。
GEO_RELAY_ENABLED=true

# 三个 MMDB 下载直链。以下地址来自第三方 P3TERX 项目，也可以替换为自己的可信地址。
GEOIP_COUNTRY_DB_URL=https://github.com/P3TERX/GeoLite.mmdb/raw/download/GeoLite2-Country.mmdb
GEOIP_CITY_DB_URL=https://github.com/P3TERX/GeoLite.mmdb/raw/download/GeoLite2-City.mmdb
GEOIP_ASN_DB_URL=https://github.com/P3TERX/GeoLite.mmdb/raw/download/GeoLite2-ASN.mmdb

# 数据库持久化位置。Compose 把 /root 映射到宿主机持久化目录。
GEOIP_COUNTRY_DB_PATH=/root/geoip/GeoLite2-Country.mmdb
GEOIP_CITY_DB_PATH=/root/geoip/GeoLite2-City.mmdb
GEOIP_ASN_DB_PATH=/root/geoip/GeoLite2-ASN.mmdb

# 更新时间支持 m（分钟）、h（小时）、d（天）；默认 168h，即每周一次。
# 为兼容旧版本，纯数字仍按秒解释；0 表示关闭周期更新。
GEOIP_UPDATE_INTERVAL=168h

# 启动时只更新缺失或已过期的数据库；设为 true 可强制每次启动下载。
GEOIP_UPDATE_ON_START=true
GEOIP_FORCE_UPDATE_ON_START=false

# City 数据库较大，慢速网络可继续提高超时。
GEOIP_DOWNLOAD_TIMEOUT=600
GEOIP_MIN_BYTES=65536

# 多行 YAML v2 规则：从上到下检查，首条匹配且存在在线节点的规则生效。
# client_a/client_b 默认对称匹配；同一字段中的多个值是“或”，不同字段是“且”。
# all、any、not 可以任意嵌套；relay_tiers 每一行是一个故障转移优先级。
GEO_RELAY_RULES='version: 2
rules:
  # 同区域、不同运营商：上海电信与上海移动之间优先中国节点。
  - name: "上海：中国电信与中国移动"
    match:
      client_a:
        all:
          - country: CN
          - city: [Shanghai, 上海]
          - any:
              - asn: 4134
              - asn_org_contains: "China Telecom"
      client_b:
        all:
          - country: CN
          - city: [Shanghai, 上海]
          - any:
              - asn: 9808
              - asn_org_contains: "China Mobile"
    relay_tiers:
      - [relay-cn.example.com]
      - [relay-jp.example.com]
      - [relay-us.example.com]

  # 同运营商、不同区域：中国电信上海与北京。
  - name: "中国电信：上海与北京"
    match:
      client_a:
        all:
          - country: CN
          - city: [Shanghai, 上海]
          - asn: 4134
      client_b:
        all:
          - country: CN
          - city: [Beijing, 北京]
          - asn: 4134
    relay_tiers:
      - [relay-cn.example.com]
      - [relay-jp.example.com]

  # CN-CN：比后面的跨国和默认规则优先。
  - name: "CN-CN"
    match:
      client_a: { country: CN }
      client_b: { country: CN }
    relay_tiers:
      - [relay-cn.example.com]
      - [relay-jp.example.com]
      - [relay-us.example.com]

  # CN-JP
  - name: "CN-JP"
    match:
      client_a: { country: CN }
      client_b: { country: JP }
    relay_tiers:
      - [relay-jp.example.com]
      - [relay-cn.example.com]
      - [relay-us.example.com]

  # CN-US
  - name: "CN-US"
    match:
      client_a: { country: CN }
      client_b: { country: US }
    relay_tiers:
      - [relay-us.example.com]
      - [relay-jp.example.com]
      - [relay-cn.example.com]

  # JP-JP
  - name: "JP-JP"
    match:
      client_a: { country: JP }
      client_b: { country: JP }
    relay_tiers:
      - [relay-jp.example.com]
      - [relay-us.example.com]

  # JP-US
  - name: "JP-US"
    match:
      client_a: { country: JP }
      client_b: { country: US }
    relay_tiers:
      - [relay-us.example.com]
      - [relay-jp.example.com]

  # US-US
  - name: "US-US"
    match:
      client_a: { country: US }
      client_b: { country: US }
    relay_tiers:
      - [relay-us.example.com]

  # 最后一块是不限制国家、城市或 ASN 的默认规则。
  - name: "DEFAULT"
    match: {}
    relay_tiers:
      - [relay-jp.example.com]
      - [relay-us.example.com]
      - [relay-cn.example.com]
'

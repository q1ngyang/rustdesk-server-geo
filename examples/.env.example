# RustDesk 客户端统一使用的服务器地址。
RUSTDESK_ID_SERVER=desk-id.example.com

# hbbs 负责健康检查的全部 hbbr；必须包含 Geo 规则里出现的所有节点。
RUSTDESK_RELAY_SERVERS=relay-hk-1.example.com,relay-hk-2.example.com,relay-jp.example.com,relay-us.example.com

# 是否启用基于双方国家组合的 Relay 选择。
GEO_RELAY_ENABLED=true

# MaxMind DB 兼容的 Country 数据库直链。以下地址来自第三方 P3TERX 项目，
# 也可以替换为自己的 MaxMind 下载地址、对象存储地址或其他可信镜像。
GEOIP_DB_URL=https://github.com/P3TERX/GeoLite.mmdb/raw/download/GeoLite2-Country.mmdb

# 数据库持久化位置。Compose 把 /root 映射到宿主机持久化目录。
GEOIP_DB_PATH=/root/geoip/GeoLite2-Country.mmdb

# 更新周期，单位为秒；86400 表示每天一次，0 表示关闭周期更新。
GEOIP_UPDATE_INTERVAL=86400

# 容器启动时是否立即检查并下载一次数据库。
GEOIP_UPDATE_ON_START=true

# 规则语法：
# ; 分隔规则，= 分隔国家组合和节点，, 表示同级轮询，> 表示故障后的下一优先级。
# 国家组合顺序不敏感，JP-CN 会自动规范化为 CN-JP。
GEO_RELAY_RULES='CN-CN=relay-hk-1.example.com,relay-hk-2.example.com>relay-jp.example.com;CN-JP=relay-jp.example.com>relay-hk-1.example.com,relay-hk-2.example.com;CN-US=relay-us.example.com>relay-jp.example.com;JP-JP=relay-jp.example.com>relay-hk-1.example.com;JP-US=relay-us.example.com>relay-jp.example.com;US-US=relay-us.example.com;DEFAULT=relay-jp.example.com>relay-hk-1.example.com,relay-hk-2.example.com>relay-us.example.com'
